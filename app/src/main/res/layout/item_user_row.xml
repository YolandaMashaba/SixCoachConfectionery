<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="16dp"
    android:background="?attr/selectableItemBackground">

    <TextView
        android:id="@+id/tvUserUsername"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="3.0"
        android:text="ST10385107@rcconnect.edu.za"
        android:textColor="@color/bakery_text_primary"
        android:textSize="13sp"
        android:ellipsize="end"
        android:maxLines="1" />

    <!-- Role Badge (Flat Pill Style) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.5"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvUserRoleBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Admin"
            android:textColor="@color/bakery_text_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingHorizontal="12dp"
            android:paddingVertical="5dp"
            android:background="@drawable/bg_role_badge" />

    </LinearLayout>

    <!-- Actions (Edit & Delete) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.5"
        android:orientation="horizontal"
        android:gravity="center">

        <ImageButton
            android:id="@+id/btnEditUser"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_custom_input"
            android:contentDescription="Edit user role"
            android:src="@drawable/ic_edit"
            app:tint="@color/bakery_brown" />

        <ImageButton
            android:id="@+id/btnDeleteUser"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_custom_input"
            android:contentDescription="Delete user"
            android:src="@drawable/ic_delete"
            app:tint="@color/bakery_red" />

    </LinearLayout>

</LinearLayout>
