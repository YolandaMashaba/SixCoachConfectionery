<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_card_rounded">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Checkout Payment"
        android:textColor="@color/bakery_text_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@color/bakery_tan_light"
        android:padding="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Order Total"
            android:textColor="@color/bakery_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDialogOrderTotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="R 29.00"
            android:textColor="@color/bakery_green"
            android:textSize="22sp"
            android:textStyle="bold" />

    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Payment Method"
        android:textColor="@color/bakery_text_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/rgPaymentMethod"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/rbCash"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Cash"
            android:checked="true"
            android:textColor="@color/bakery_text_primary" />

        <RadioButton
            android:id="@+id/rbCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Card"
            android:textColor="@color/bakery_text_primary" />

    </RadioGroup>

    <!-- Cash Payment Input Section -->
    <LinearLayout
        android:id="@+id/layoutCashSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Amount Tendered (R)"
            android:textColor="@color/bakery_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etAmountTendered"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_custom_input"
            android:hint="0.00"
            android:inputType="numberDecimal"
            android:paddingHorizontal="14dp"
            android:textColor="@color/bakery_text_primary"
            android:textSize="16sp" />

        <!-- Quick Cash Buttons -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnQuickExact"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Exact"
                    android:textSize="12sp"
                    android:textColor="@color/bakery_brown"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btnQuick10"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="+R10"
                    android:textSize="12sp"
                    android:textColor="@color/bakery_brown"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btnQuick20"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="+R20"
                    android:textSize="12sp"
                    android:textColor="@color/bakery_brown"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btnQuick50"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="+R50"
                    android:textSize="12sp"
                    android:textColor="@color/bakery_brown"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btnQuick100"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="+R100"
                    android:textSize="12sp"
                    android:textColor="@color/bakery_brown" />

            </LinearLayout>

        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Change Due:"
                android:textColor="@color/bakery_text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvChangeDue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="R 0.00"
                android:textColor="@color/bakery_brown_dark"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/tvCheckoutError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/bakery_red"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvCashierInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Cashier: ST10385107@rcconnect.edu.za"
        android:textColor="@color/bakery_text_muted"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/btnCancelCheckout"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Cancel"
            android:textColor="@color/bakery_brown"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnConfirmPayment"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Complete Payment"
            android:textColor="@color/white"
            android:backgroundTint="@color/bakery_green" />

    </LinearLayout>

</LinearLayout>