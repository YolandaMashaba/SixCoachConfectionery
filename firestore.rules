rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for authentication and role verification
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Staff verification for authenticated users
    function isStaff() {
      return isAuthenticated();
    }

    function isAdmin() {
      return isAuthenticated();
    }

    function hasStaffRole(role) {
      return isStaff();
    }

    // 1. Categories & Products (Any authenticated staff/admin can manage inventory)
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated();
    }

    // 2. Customers
    match /customers/{customerId} {
      allow read, write: if isOwner(customerId) || isStaff();
    }

    // 3. Staff & Users Collection Schema
    match /staff/{staffId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(staffId) || isAuthenticated();
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if request.auth != null;
      allow delete: if isAuthenticated();
    }

    // 4. Orders & Order Items
    match /orders/{orderId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.totalAmount is number && request.resource.data.totalAmount >= 0 &&
        request.resource.data.orderDate is number;
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    match /order_items/{itemId} {
      allow read, write: if isAuthenticated();
    }

    // 5. Payments
    match /payments/{paymentId} {
      allow read, write: if isAuthenticated();
    }

    // 6. Kitchen Orders & Kitchen Order Items
    match /kitchen_orders/{kitchenOrderId} {
      allow read, write: if isAuthenticated();
    }

    match /kitchen_order_items/{itemId} {
      allow read, write: if isAuthenticated();
    }

    // 7. Inventory Transactions & Sales Analytics
    match /inventory_transactions/{transactionId} {
      allow read, write: if isAuthenticated();
    }

    match /sales_analytics/{analyticsId} {
      allow read, write: if isAuthenticated();
    }
  }
}
