rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for authentication and role verification
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Staff verification for authenticated users
    function isStaff() {
      return isAuthenticated();
    }

    function isAdmin() {
      return isAuthenticated() &&
        (request.auth.token.email == 'admin@email.com' ||
         request.auth.token.email == 'ST10385107@rcconnect.edu.za' ||
         (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true ||
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin')));
    }

    function hasStaffRole(role) {
      return isStaff();
    }

    // 1. Categories & Products (Admin creates/deletes; Staff can update stock during sales)
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAuthenticated() &&
        request.resource.data.productName == resource.data.productName &&
        request.resource.data.categoryId == resource.data.categoryId &&
        request.resource.data.price == resource.data.price &&
        request.resource.data.costPrice == resource.data.costPrice &&
        request.resource.data.imageURL == resource.data.imageURL &&
        request.resource.data.dateAdded == resource.data.dateAdded &&
        request.resource.data.quantityInStock is number &&
        request.resource.data.quantityInStock >= 0 &&
        request.resource.data.quantityInStock <= resource.data.quantityInStock &&
        request.resource.data.availability in ['In Stock', 'Out of Stock'];
    }

    // 2. Customers
    match /customers/{customerId} {
      allow read, write: if isOwner(customerId) || isStaff();
    }

    // 3. Staff & Users Collection Schema
    match /staff/{staffId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(staffId) || isAdmin();
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && request.auth.uid == userId;
      allow delete: if isAdmin();
    }

    // 4. Orders & Order Items
    match /orders/{orderId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.totalAmount is number && request.resource.data.totalAmount >= 0 &&
        request.resource.data.orderDate is number;
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    match /order_items/{itemId} {
      allow read, write: if isAuthenticated();
    }

    // 5. Payments
    match /payments/{paymentId} {
      allow read, write: if isAuthenticated();
    }

    // 6. Kitchen Orders & Kitchen Order Items
    match /kitchen_orders/{kitchenOrderId} {
      allow read, write: if isAuthenticated();
    }

    match /kitchen_order_items/{itemId} {
      allow read, write: if isAuthenticated();
    }

    // 7. Inventory Transactions & Sales Analytics
    match /inventory_transactions/{transactionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.staffId == request.auth.uid &&
        request.resource.data.productId is string &&
        request.resource.data.productId.size() > 0 &&
        request.resource.data.quantity is number &&
        request.resource.data.quantity > 0 &&
        request.resource.data.transactionType == 'Sale' &&
        request.resource.data.notes is string &&
        request.resource.data.transactionId == transactionId;
      allow update, delete: if isAdmin();
    }

    match /sales_analytics/{analyticsId} {
      allow read, write: if isAuthenticated();
    }
  }
}
